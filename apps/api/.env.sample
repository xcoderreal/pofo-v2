# Backend environment variables (OPTIONAL)
#
# Copy to .env.local if you need to override defaults:
#   cp .env.sample .env.local
#
# Loaded by pydantic-settings when the backend starts (see src/myapp/config.py).
# All vars must be prefixed with MYAPP_. .env.local is gitignored;
# .env.sample is checked in as documentation.

# Secret key — change in production.
#MYAPP_SECRET_KEY=change-me

# Port the uvicorn server binds to (default: 8090).
# Read by both pydantic-settings AND the justfile's `api` recipe via shell
# expansion. If you change this, also set EXPO_PUBLIC_API_URL in
# apps/mobile/.env.local so the frontend hits the right port.
#MYAPP_PORT=8090

# "development" (default) or "production". A startup check rejects
# MYAPP_AUTH=stub whenever this is "production" — stub auth bypasses Row
# Level Security via the service-role key.
#MYAPP_ENV=development

# "stub" (default) returns a fixed dev user — fine for local dev and CI,
# never for production. "supabase" verifies a real Supabase-issued JWT.
#MYAPP_AUTH=stub

# MYAPP_REPOSITORY (memory|supabase) + MYAPP_SUPABASE_URL/KEY land with the
# first ticket that builds a real Supabase-backed repository — see
# docs/environments.md for the target design. Not added here yet since
# nothing in this codebase constructs one to select between.

# Required when MYAPP_AUTH=supabase. Verifies Supabase-issued JWTs.
# Local Supabase CLI stacks all share the same well-known dev value
# (`super-secret-jwt-token-with-at-least-32-characters-long`) — hosted
# Supabase generates a unique one per project (Project Settings -> API ->
# JWT Secret).
#MYAPP_SUPABASE_JWT_SECRET=

# NOT read by pydantic-settings/Settings — read directly by the RLS
# enforcement proof test tier (apps/api/tests/rls/, `just test-rls`).
# Point these at a dedicated *test* Supabase project only, never dev or
# prod. Skips cleanly (not a failure) when unset. See docs/security.md's
# RLS checklist and docs/testing.md's "sixth tier" section.
#MYAPP_SUPABASE_TEST_URL=
#MYAPP_SUPABASE_TEST_ANON_KEY=
#MYAPP_SUPABASE_TEST_SERVICE_KEY=
