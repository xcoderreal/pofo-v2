  "components": {
    "schemas": {
      "AccountResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "institution": {
            "type": "string",
            "title": "Institution"
          },
          "account_type": {
            "$ref": "#/components/schemas/AccountType"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "institution",
          "account_type"
        ],
        "title": "AccountResponse"
      },
      "AccountType": {
        "type": "string",
        "enum": [
          "brokerage",
          "ira",
          "crypto_exchange",
          "cash"
        ],
        "title": "AccountType"
      },
      "AssetClass": {
        "type": "string",
        "enum": [
          "equity",
          "etf",
          "crypto",
          "cash"
        ],
        "title": "AssetClass"
      },
      "CreateAccountRequest": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "institution": {
            "type": "string",
            "title": "Institution"
          },
          "account_type": {
            "$ref": "#/components/schemas/AccountType"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "institution",
          "account_type"
        ],
        "title": "CreateAccountRequest"
      },
      "CreateInstrumentRequest": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "symbol": {
            "type": "string",
            "title": "Symbol"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "asset_class": {
            "$ref": "#/components/schemas/AssetClass"
          }
        },
        "type": "object",
        "required": [
          "id",
          "symbol",
          "name",
          "asset_class"
        ],
        "title": "CreateInstrumentRequest"
      },
      "CreateTransactionRequest": {
        "properties": {
          "account_id": {
            "type": "string",
            "title": "Account Id"
          },
          "instrument_id": {
            "type": "string",
            "title": "Instrument Id"
          },
          "type": {
            "$ref": "#/components/schemas/TransactionType"
          },
          "quantity": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              }
            ],
            "title": "Quantity"
          },
          "price": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              }
            ],
            "title": "Price"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Timestamp"
          }
        },
        "type": "object",
        "required": [
          "account_id",
          "instrument_id",
          "type",
          "quantity",
          "price",
          "timestamp"
        ],
        "title": "CreateTransactionRequest"
      },
      "DemoSeedResponse": {
        "properties": {
          "seeded": {
            "type": "boolean",
            "title": "Seeded"
          }
        },
        "type": "object",
        "required": [
          "seeded"
        ],
        "title": "DemoSeedResponse"
      },
      "DepositRequest": {
        "properties": {
          "account_id": {
            "type": "string",
            "title": "Account Id"
          },
          "amount": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              }
            ],
            "title": "Amount"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Timestamp"
          }
        },
        "type": "object",
        "required": [
          "account_id",
          "amount",
          "timestamp"
        ],
        "title": "DepositRequest"
      },
      "Granularity": {
        "type": "string",
        "enum": [
          "daily",
          "weekly",
          "monthly",
          "yearly"
        ],
        "title": "Granularity"
      },
      "GroupBy": {
        "type": "string",
        "enum": [
          "none",
          "instrument",
          "account"
        ],
        "title": "GroupBy"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "InstrumentResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "symbol": {
            "type": "string",
            "title": "Symbol"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "asset_class": {
            "$ref": "#/components/schemas/AssetClass"
          }
        },
        "type": "object",
        "required": [
          "id",
          "symbol",
          "name",
          "asset_class"
        ],
        "title": "InstrumentResponse"
      },
      "InsufficientFundsDetail": {
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "insufficient_cash",
              "insufficient_shares"
            ],
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "account_id": {
            "type": "string",
            "title": "Account Id"
          },
          "instrument_id": {
            "type": "string",
            "title": "Instrument Id"
          },
          "requested": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Requested"
          },
          "available": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Available"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message",
          "account_id",
          "instrument_id",
          "requested",
          "available"
        ],
        "title": "InsufficientFundsDetail",
        "description": "Why a write was rejected with 409, in a shape a client can branch on.\n\n`code` is the whole point. Both variants are the same FIFO overdraw\n(docs/adr/0001-dashboard-v2.md \u00a7 4), but they need different words on\nscreen: an over-sell asks the user to sell fewer units, while a buy the\naccount cannot pay for asks them to record the funding Deposit that\nbelongs earlier in the ledger. A plain string `detail` forces the client\nto substring-match a sentence to tell those apart.\n\n`requested`/`available` come along so the client can state the shortfall\nexactly rather than re-deriving it from a `market_value` that was\ncomputed for today rather than for the transaction's own date."
      },
      "InsufficientFundsResponse": {
        "properties": {
          "detail": {
            "$ref": "#/components/schemas/InsufficientFundsDetail"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "InsufficientFundsResponse",
        "description": "The 409 body itself \u2014 FastAPI wraps every error in `detail`, and\ndocumenting the inner model alone would describe a payload this API\nnever sends."
      },
      "LedgerEntryResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "account_id": {
            "type": "string",
            "title": "Account Id"
          },
          "instrument_id": {
            "type": "string",
            "title": "Instrument Id"
          },
          "type": {
            "$ref": "#/components/schemas/TransactionType"
